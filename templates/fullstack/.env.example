# Copy to .env (gitignored). Read by `pnpm run dev`, tests, migrations and `docker compose`.
# Generate secrets with: openssl rand -base64 32
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=postgres
# Local dev and tests. Inside compose, the app and migrate services use the postgres service instead.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/b7
BETTER_AUTH_URL=http://localhost:3000
# Public URL served by Caddy in `docker compose up`. https://your.domain gets a Let's Encrypt certificate.
APP_URL=http://localhost
# #if email
EMAIL_FROM="B7 <onboarding@resend.dev>"
# Optional in local dev: without it, emails are printed to the dev server log instead of sent.
RESEND_API_KEY=
# #endif
# #if billing
# Shared with the scheduler service for the daily billing reconciliation. Generate with: openssl rand -base64 32
CRON_SECRET=
# #endif
# #if billing=stripe
# Stripe keys (test mode for development). Unset: the app runs and billing calls fail with "not configured".
# Webhook endpoint: <APP_URL>/api/webhooks/stripe. Locally: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
# #endif
