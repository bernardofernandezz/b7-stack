{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "b7-fullstack",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Create with: wrangler hyperdrive create b7-fullstack --connection-string=... --caching-disabled
      "id": "00000000000000000000000000000000",
      // Docker Compose database (pnpm run db:up). Used only by local dev; ignored on deploy.
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/b7"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:3000",
    "EMAIL_FROM": "B7 <onboarding@resend.dev>"
  }
}
